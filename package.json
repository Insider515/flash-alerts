{
  "name": "flash-alerts",
  "version": "0.1.1",
  "description": "Zero-dependency browser alerts/toasts with configurable position, effects, styles and presets.",
  "keywords": [
    "alert",
    "alerts",
    "toast",
    "notification",
    "notify",
    "flash",
    "typing",
    "dashboard",
    "zero-dependencies"
  ],
  "main": "./index.js",
  "module": "./index.mjs",
  "browser": "./dist/flash-alerts.min.js",
  "types": "./index.d.ts",
  "unpkg": "./dist/flash-alerts.min.js",
  "jsdelivr": "./dist/flash-alerts.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./dist/flash-alerts.min.js",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./min": "./dist/flash-alerts.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "terser src/flash-alerts.js --compress --mangle --comments false -o dist/flash-alerts.min.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "author": "Insider515",
  "license": "MIT",
  "homepage": "https://insider515.github.io/flash-alerts/examples/demo.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Insider515/flash-alerts.git"
  },
  "bugs": {
    "url": "https://github.com/Insider515/flash-alerts/issues"
  },
  "sideEffects": false,
  "devDependencies": {
    "jsdom": "^24.1.3",
    "terser": "^5.51.2"
  }
}
